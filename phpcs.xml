<?xml version="1.0"?>
<ruleset name="WP-DownloadManager">
	<description>WordPress Coding Standards for WP-DownloadManager.</description>

	<file>.</file>

	<!-- WPCS has no JavaScript sniffs; never let PHPCS touch .js. -->
	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- Scanning these makes the CI runner run out of memory. -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<rule ref="WordPress"/>

	<config name="text_domain" value="wp-downloadmanager"/>
	<config name="minimum_wp_version" value="6.8"/>

	<!--
		manage_downloads is this plugin's own capability, added to the
		administrator role on activation. The sniff only knows core's list, so
		it has to be told. This is configuration, not a relaxation.
	-->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_downloads"/>
			</property>
		</properties>
	</rule>

	<!--
		wp_kses_post() and wp_kses() are the sanitizers for the two fields that
		are allowed to carry markup - a file's display name and its description.
		WPCS only knows core's list, so they are declared here rather than
		silenced at each call site.
	-->
	<rule ref="WordPress.Security.ValidatedSanitizedInput">
		<properties>
			<property name="customSanitizingFunctions" type="array">
				<element value="wp_kses_post"/>
				<element value="wp_kses"/>
			</property>
		</properties>
	</rule>

	<!--
		=== Sniffs that are wrong for this plugin, not code that needs fixing ===

		Everything below is a sniff whose premise does not hold for a plugin
		that owns a database table and streams files out of it. They are turned
		off here, in one reviewable list with a reason each, rather than with
		inline phpcs:ignore comments scattered through includes/.
	-->

	<!--
		The plugin owns one table, {$wpdb->prefix}downloads. There is no core
		API that reads it and no object cache to prime, so "use a core function"
		and "add caching" have no answer here.
	-->
	<rule ref="WordPress.DB.DirectDatabaseQuery.DirectQuery">
		<severity>0</severity>
	</rule>
	<rule ref="WordPress.DB.DirectDatabaseQuery.NoCaching">
		<severity>0</severity>
	</rule>

	<!--
		Creating and dropping that table is the entire job of the installer and
		the uninstaller.
	-->
	<rule ref="WordPress.DB.DirectDatabaseQuery.SchemaChange">
		<severity>0</severity>
	</rule>

	<!--
		A table identifier cannot be bound as a placeholder, and every query in
		the plugin interpolates exactly one thing: $wpdb->downloads, which the
		plugin registers itself. Values are always bound.
	-->
	<rule ref="WordPress.DB.PreparedSQL.InterpolatedNotPrepared">
		<severity>0</severity>
	</rule>

	<!--
		The search clause in the downloads listing is carried as a placeholder
		fragment plus its argument list, so the number of placeholders is
		decided at run time - three per search term, plus the two LIMIT bounds.
		The sniff can only count them statically.
	-->
	<rule ref="WordPress.DB.PreparedSQLPlaceholders.ReplacementsWrongNumber">
		<severity>0</severity>
	</rule>

	<!--
		The download endpoint streams the file with readfile() so a multi-gigabyte
		download does not have to fit in PHP's memory limit, and moves an
		uploaded file with rename() inside the downloads directory. WP_Filesystem
		reads whole files into a string and needs credentials, so neither has a
		usable replacement here.
	-->
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_readfile">
		<severity>0</severity>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.rename_rename">
		<severity>0</severity>
	</rule>

	<!--
		The public downloads listing reads ?dl_cat, ?dl_page and ?dl_search to
		decide what to render and writes nothing at all. There is no state change
		for a nonce to protect, and a nonce on a shareable, bookmarkable,
		crawlable listing URL would break every one of those. Every screen that
		writes checks one.
	-->
	<rule ref="WordPress.Security.NonceVerification">
		<exclude-pattern>/includes/class-wp-downloadmanager-display.php</exclude-pattern>
	</rule>

	<!--
		The endpoint redirects to whatever URL the file is stored at, which for
		a remote file is deliberately off-site. wp_safe_redirect() would send
		every one of those visitors to the dashboard instead.
	-->
	<rule ref="WordPress.Security.SafeRedirect.wp_redirect_wp_redirect">
		<severity>0</severity>
	</rule>

	<!--
		Everything below relaxes a sniff for the test suite only, and this list
		is closed: it is identical in all nineteen plugins. A sniff firing in
		includes/ is a bug in the code, not a missing exclusion - fix the code.
	-->

	<!-- The tests assert on the plugin's own markup, so they must not escape it. -->
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!--
		A test method's name is its documentation - test_a_malformed_range_does_
		not_ban_everyone() gains nothing from a docblock repeating it. Required
		everywhere else.
	-->
	<rule ref="Squiz.Commenting.FunctionComment.Missing">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.DocComment.MissingShort">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!--
		Test files are named test-*.php by WordPress convention rather than
		class-*.php; the coding standard excepts test classes from that rule.
	-->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!--
		The tests read wp_options directly to assert which rows the migration
		left behind. There is no API for "which rows exist".
	-->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!--
		The tests drive superglobals to simulate proxy headers and form posts;
		that is the behaviour under test, not unvalidated input.
	-->
	<rule ref="WordPress.Security.ValidatedSanitizedInput">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.NonceVerification">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- The tests read the plugin's own source; WP_Filesystem is not appropriate. -->
	<rule ref="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!--
		The admin-screen tests install an error handler on purpose: collecting
		the diagnostics is what makes them more than smoke tests.
	-->
	<rule ref="WordPress.PHP.DevelopmentFunctions.error_log_set_error_handler">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!--
		The settings tests set $hook_suffix, which wp-admin would have set before
		any page callback ran. WP_List_Table's constructor reaches
		WP_Screen::get(), which reads that global, so the test bootstrap has to
		stand in for admin.php.
	-->
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
